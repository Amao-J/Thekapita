{
  "expo": {
    "name": "theKapita",
    "slug": "thekapita",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thekapita.app"
    },
    "android": {
      "package": "com.thekapita.app"
    },
    "extra": {
      "apiBaseUrl": "http://192.168.0.182:8000/api"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-vector-icons/ionicons",
      "react-native-bottom-tabs"
    ]
  }
}
