VITE_API_BASE_URL=https://api.thekapita.com/api

# Optional: reverse geocoder + request spacing (defaults are free Nominatim: max 1 request/second)
# VITE_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# VITE_GEOCODER_MIN_GAP_MS=1100

# Optional live-traffic colours on the live ride map. Use the traffic-flow tile URL from your provider (e.g. TomTom).
# This key is visible to browsers: restrict it to your domain. Leave unset to skip the overlay.
# VITE_TRAFFIC_OVERLAY_URL=
# VITE_TRAFFIC_ATTRIBUTION=
