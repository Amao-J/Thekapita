+def driver_payout_for(fare: Decimal) -> Decimal:
+    pct = Decimal(str(getattr(settings, "RIDE_PLATFORM_FEE_PERCENT", "12.5")))
+    return (fare * (Decimal("100") - pct) / Decimal("100")).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
